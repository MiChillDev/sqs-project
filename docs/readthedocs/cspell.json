{
  "version": "0.2",
  "language": "en",
  "dictionaries": ["project-words"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "files": ["**/*.md"],
  "ignorePaths": [".mkdocs.yaml", ".readthedocs.yaml", "requirements.txt"],
  "ignoreRegExpList": [
    "`[^`]+`",
    "```[\\s\\S]*?```",
    "https?://[^\\s)>]+",
    "\\[([^\\]]+)\\]\\([^)]+\\)"
  ]
}
