%% C4 Level 2 - Container Diagram
%% Chuck Norris Joke Page

graph TB
    User["End User"]

    subgraph SQS["sqs-project [Software System]"]
        SPA["Web App<br/>React 19 + TypeScript<br/>Vite SPA<br/>[Container]"]
        API["API Backend<br/>Spring Boot 4<br/>Java 21<br/>[Container]"]
        DB["Database<br/>PostgreSQL 16<br/>[Container]"]
    end

    CN_API["Chuck Norris API<br/>api.chucknorris.io<br/>[External System]"]

    User -->|"Browses & uses"| SPA
    SPA -->|"REST calls via<br/>HTTPS/JSON"| API
    API -->|"Reads/writes via<br/>JDBC"| DB
    API -->|"Fetches jokes via<br/>HTTPS"| CN_API

    classDef person fill:#08427b,color:#fff,stroke:#052e56
    classDef container fill:#1168bd,color:#fff,stroke:#0b4884
    classDef external fill:#999,color:#fff,stroke:#6b6b6b

    class User person
    class SPA,API,DB container
    class CN_API external
