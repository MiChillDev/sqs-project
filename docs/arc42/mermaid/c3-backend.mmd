%% C4 Level 3 - Backend Components
%% Chuck Norris Joke Page

graph TB
    subgraph JokesDomain[" Jokes Domain"]
        JokeCtrl["JokeController<br/>GET /jokes<br/>POST /jokes<br/>GET /source-joke<br/>[RestController]"]
        JokeSvc["JokeService<br/>[Business Logic]"]
        JokeRepo["JokeRepository<br/>[Interface]"]
        JokeRepoImpl["JokeRepositoryImpl<br/>[Delegates to Spring]"]
        SpringJokeRepo["SpringJokeRepository<br/>[JpaRepository]"]
        ChuckNorrisRepo["ChuckNorrisApiJokeRepositoryImpl<br/>extends ApiRepository<br/>[External API Client]"]
    end

    subgraph AuthDomain[" Auth Domain"]
        AuthCtrl["AuthController<br/>POST /auth/login<br/>[RestController]"]
        AuthSvc["AuthService<br/>Login + Token Validation"]
        AuthRepo["AuthRepository<br/>[Interface]"]
        AuthRepoImpl["AuthRepositoryImpl<br/>[Delegates to Spring]"]
        SpringAuthRepo["SpringAuthSessionRepository<br/>[JpaRepository]"]
    end

    subgraph UsersDomain[" Users Domain"]
        UserSvc["UserService"]
        UserRepo["UserRepository<br/>[Interface]"]
        UserRepoImpl["UserRepositoryImpl<br/>[Delegates to Spring]"]
        SpringUserRepo["SpringUserRepository<br/>[JpaRepository]"]
    end

    subgraph HealthDomain[" Health"]
        HealthCtrl["HealthController<br/>GET /health<br/>[RestController]"]
    end

    subgraph CommonInfra[" Common Infrastructure"]
        BaseCtrl["BaseController<br/>executeAuthenticated()<br/>executeUnauthenticated()<br/>handleEither()<br/>[Template Method]"]
        Either["Either<L,R><br/>Monad"]
        ErrorStatus["ErrorResultStatus"]
        PWHasher["PasswordHasher<br/>PBKDF2"]
        ApiRepo["ApiRepository<br/>RestTemplate<br/>[Abstract Class]"]
    end

    DB[("PostgreSQL 16<br/>Database")]
    CN_API["Chuck Norris API<br/>api.chucknorris.io"]

    JokeCtrl --> JokeSvc
    JokeCtrl -.-> BaseCtrl
    JokeSvc --> JokeRepo
    JokeSvc --> ChuckNorrisRepo
    JokeRepo --> JokeRepoImpl
    JokeRepoImpl --> SpringJokeRepo
    SpringJokeRepo --> DB
    ChuckNorrisRepo --> ApiRepo
    ChuckNorrisRepo -->|"HTTPS GET /jokes/random"| CN_API

    AuthCtrl --> AuthSvc
    AuthCtrl -.-> BaseCtrl
    AuthSvc --> AuthRepo
    AuthSvc --> UserRepo
    AuthSvc --> PWHasher
    AuthRepo --> AuthRepoImpl
    AuthRepoImpl --> SpringAuthRepo
    SpringAuthRepo --> DB

    UserSvc --> UserRepo
    UserRepo --> UserRepoImpl
    UserRepoImpl --> SpringUserRepo
    SpringUserRepo --> DB

    HealthCtrl -.-> BaseCtrl

    BaseCtrl --> AuthSvc
    BaseCtrl --> Either
    BaseCtrl --> ErrorStatus

    ApiRepo --> Either
    ApiRepo --> ErrorStatus

    classDef domain fill:#1168bd,color:#fff,stroke:#0b4884
    classDef component fill:#438dd5,color:#fff,stroke:#2a6bab
    classDef infra fill:#999,color:#fff,stroke:#6b6b6b
    classDef db fill:#666,color:#fff,stroke:#444
    classDef external fill:#6b6b6b,color:#fff,stroke:#444

    class JokesDomain,AuthDomain,UsersDomain,HealthDomain,CommonInfra domain
    class JokeCtrl,JokeSvc,JokeRepo,JokeRepoImpl,SpringJokeRepo,ChuckNorrisRepo component
    class AuthCtrl,AuthSvc,AuthRepo,AuthRepoImpl,SpringAuthRepo component
    class UserSvc,UserRepo,UserRepoImpl,SpringUserRepo component
    class HealthCtrl component
    class BaseCtrl,Either,ErrorStatus,PWHasher,ApiRepo infra
    class DB db
    class CN_API external
