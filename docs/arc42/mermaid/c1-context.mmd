%% C4 Level 1 - System Context Diagram
%% Chuck Norris Joke Page

graph TB
    User["End User"]
    Admin["Administrator"]
    SQS["sqs-project<br/>Chuck Norris Joke Page<br/>[Software System]"]

    CN_API["Chuck Norris API<br/>api.chucknorris.io<br/>[External System]"]
    DB["PostgreSQL Database<br/>[External System]"]

    User -->|"Browses jokes"| SQS
    Admin -->|"Imports and<br/>manages jokes via"| SQS
    SQS -->|"Fetches jokes via<br/>HTTPS/JSON"| CN_API
    SQS -->|"Persists & queries<br/>data via JDBC"| DB

    classDef person fill:#08427b,color:#fff,stroke:#052e56
    classDef system fill:#1168bd,color:#fff,stroke:#0b4884
    classDef external fill:#999,color:#fff,stroke:#6b6b6b

    class User,Admin person
    class SQS system
    class CN_API,DB external
