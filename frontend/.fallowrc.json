{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "boundaries": {
    "zones": [
      {
        "name": "routes-login",
        "patterns": ["src/app/routes/login/**"]
      },
      {
        "name": "routes-admin",
        "patterns": ["src/app/routes/admin/**"]
      },
      {
        "name": "routes-shared",
        "patterns": ["src/app/routes/*.tsx", "src/app/routes/*.ts"]
      },
      {
        "name": "app-core",
        "patterns": ["src/app/providers/**", "src/app/router.ts"]
      },
      { "name": "shared", "patterns": ["src/shared/**"] }
    ],
    "rules": [
      { "from": "routes-login", "allow": ["shared", "routes-shared"] },
      { "from": "routes-admin", "allow": ["shared", "routes-shared"] },
      { "from": "routes-shared", "allow": ["shared"] },
      { "from": "app-core", "allow": ["shared", "routes-login", "routes-admin", "routes-shared"] },
      { "from": "shared", "allow": [] }
    ]
  },
  "rules": {
    "boundary-violation": "error",
    "circular-dependency": "error",
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-dependencies": "warn",
    "unused-types": "warn",
    "unused-class-members": "off",
    "unused-enum-members": "off",
    "duplicate-exports": "off"
  },
  "ignorePatterns": [
    "src/shared/api/generated/**",
    "vitest.sonar.config.ts"
  ],
  "ignoreExports": [
    { "file": "src/shared/components/ui/**", "exports": ["*"] }
  ],
  "ignoreDependencies": [
    "@fontsource-variable/geist",
    "tw-animate-css",
    "shadcn"
  ],
  "health": {
    "maxCyclomatic": 25,
    "maxCognitive": 20,
    "minScore": 90
  },
  "duplicates": {
    "threshold": 0,
    "minOccurrences": 3
  }
}
