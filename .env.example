# ----------------------------------------------------------------------------------
# SQS Project local configuration template
# ----------------------------------------------------------------------------------
# Copying this file manually is optional.
# The start-application.sh script will create a local .env automatically if missing.
#
# Do NOT put passwords, tokens, API keys, or other secrets in this file.
# Local secrets are stored in .secrets/ and mounted through Docker Compose secrets.
# ----------------------------------------------------------------------------------

# PostgreSQL non-secret configuration
POSTGRES_USER=postgres
POSTGRES_DB=sqs_db

# Published host ports
FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_PORT=5432

# Frontend API configuration
# Empty value means:
# - dev mode: Vite proxy forwards /api to the backend container
# - prod mode: nginx serves frontend and proxies /api
VITE_API_BASE_URL=
